{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "crons": [
    {
      "path": "/api/cron/process-reminders",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/cron/process-registration-credentials",
      "schedule": "*/5 * * * *"
    }
  ]
}
