# COGIC Travel marketplace providers (server-only — never expose to the browser)
# Official COGIC negotiated hotels do NOT require these credentials.
# Missing values intentionally disable the corresponding live marketplace provider
# and return truthful not_configured / unavailable states (never fake inventory).

# Hotels + Cars (preferred). Leave blank until Expedia Rapid production credentials are issued.
EXPEDIA_RAPID_API_KEY=
EXPEDIA_RAPID_API_SECRET=
EXPEDIA_RAPID_BASE_URL=https://api.ean.com
EXPEDIA_RAPID_PARTNER_POS=browser

# Flights (preferred). Leave blank until a Duffel access token is issued.
DUFFEL_ACCESS_TOKEN=
DUFFEL_BASE_URL=https://api.duffel.com
DUFFEL_API_VERSION=v2

# Optional Enterprise Amadeus only (self-service portal decommissioned July 2026).
# Leave blank unless your organization has an Enterprise Amadeus contract.
AMADEUS_API_KEY=
AMADEUS_API_SECRET=
AMADEUS_BASE_URL=https://api.amadeus.com

# Used to build partner-return URLs for marketplace booking reconciliation
NEXT_PUBLIC_APP_URL=https://cogiclive.com
