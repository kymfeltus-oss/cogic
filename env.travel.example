# COGIC Travel — production environment template (server-only secrets)
# Missing marketplace credentials intentionally disable that lane with truthful empty states.
# Official COGIC negotiated hotels do NOT require Expedia/Duffel credentials.

# ---------------------------------------------------------------------------
# REQUIRED — Expedia Rapid (hotels + cars search, price-check, book)
# ---------------------------------------------------------------------------
EXPEDIA_RAPID_API_KEY=
EXPEDIA_RAPID_API_SECRET=
EXPEDIA_RAPID_BASE_URL=https://api.ean.com
# Sent as Rapid header partner-point-of-sale; books use affiliate_reference_id = attempt id
EXPEDIA_RAPID_PARTNER_POS=browser

# ---------------------------------------------------------------------------
# REQUIRED — Duffel (flights search + order create)
# ---------------------------------------------------------------------------
DUFFEL_ACCESS_TOKEN=
DUFFEL_BASE_URL=https://api.duffel.com
DUFFEL_API_VERSION=v2

# ---------------------------------------------------------------------------
# REQUIRED — Stripe (in-app Elements + webhook payment authority)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=https://cogiclive.com
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Webhook endpoint (Stripe Dashboard → Production): https://<host>/api/webhooks/stripe
# Required events:
#   payment_intent.succeeded
#   payment_intent.payment_failed
# Travel PaymentIntent metadata (bound server-side in createTravelPaymentIntent):
#   checkout_type=travel_marketplace
#   attempt_id=<uuid>
#   transaction_id=<uuid>
#   user_id=<uuid>
#   email=<buyer email>
#   kind=hotel|flight|car
#   provider=<provider key>
#   amount_cents=<integer cents as string>
# Travel refunds also stamp checkout_type=travel_marketplace and attempt_id.

# ---------------------------------------------------------------------------
# REQUIRED — supplier change webhook HMAC (ops feed; leave blank to disable intake)
# ---------------------------------------------------------------------------
TRAVEL_SUPPLIER_WEBHOOK_SECRET=
# Partner posts to: https://<host>/api/travel/webhooks/supplier
# Header: x-cogic-travel-signature (HMAC of raw body)

# ---------------------------------------------------------------------------
# OPTIONAL — sandbox interceptors (local .env.local OR non-production cloud vault)
# ---------------------------------------------------------------------------
# Enable:
#   USE_MOCK_TRAVEL=true
#
# Allowed contexts:
#   - Local next dev (.env.local)
#   - Cloud vault / Vercel Preview / staging (VERCEL_ENV != production)
#
# Forbidden:
#   - Vercel Production (VERCEL_ENV=production) — interceptors hard-disabled
#
# When active (exact string "true"):
#   priceCheckExpediaHotel → totalRateCents=totalAmountCents=15000
#                            bookToken=mock_sandbox_token_hotel_9982
#   priceCheckExpediaCar   → totalRateCents=totalAmountCents=7500
#                            bookToken=mock_sandbox_token_car_4412
#   getDuffelOffer         → totalFareCents=totalAmountCents=32050
#                            id=mock_sandbox_offer_flight_2201
#   expediaRapidConfigured / duffelConfigured → true for create-intent
#   create-intent accepts the static demo bookToken (live exact-match still enforced off-sandbox)
#
# Does NOT mock: marketplace search results, Stripe charges, or supplier book/fulfill.
# Restart next dev or redeploy the preview after changing this value.
USE_MOCK_TRAVEL=false

# ---------------------------------------------------------------------------
# OPTIONAL — fees + Amadeus diagnostics (never checkoutable search)
# ---------------------------------------------------------------------------
TRAVEL_SERVICE_FEE_BPS=0
TRAVEL_SERVICE_FEE_CENTS=0
# Optional Enterprise Amadeus diagnostics only — NOT used for marketplace search/checkout
AMADEUS_API_KEY=
AMADEUS_API_SECRET=
AMADEUS_BASE_URL=https://api.amadeus.com

# ===========================================================================
# Smoke Test Checklist (new Supabase project / production gate)
# ===========================================================================
#
# Complete every box on the target project before declaring production PASS.
# Code green alone is insufficient (Law 24 / Law 25).
#
# ## A. Database migrations
# - [ ] Apply travel migrations in order (foundation → inventory → reservation state →
#       marketplace attempts → transactional core → coordinates → ops events → repair)
# - [ ] Reload PostgREST schema cache after migrate
# - [ ] Confirm tables exist: travel_marketplace_booking_attempts,
#       travel_booking_transactions, travel_booking_transaction_events,
#       travel_hotel_booking_journeys
#
# ## B. Credentials + webhook routing
# - [ ] Set EXPEDIA_RAPID_API_KEY / EXPEDIA_RAPID_API_SECRET / EXPEDIA_RAPID_PARTNER_POS
# - [ ] Set DUFFEL_ACCESS_TOKEN
# - [ ] Set STRIPE_SECRET_KEY, NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY, STRIPE_WEBHOOK_SECRET
# - [ ] Stripe Dashboard webhook → https://<host>/api/webhooks/stripe
#       listening for payment_intent.succeeded and payment_intent.payment_failed
# - [ ] Set TRAVEL_SUPPLIER_WEBHOOK_SECRET when partner change intake is required
#       (endpoint /api/travel/webhooks/supplier)
# - [ ] GET /api/travel/marketplace/status reflects configured lanes (no secrets leaked)
# - [ ] Owner Travel diagnostics show marketplaceReadiness.checkoutFulfillmentOperational = YES
#       when Expedia Rapid and/or Duffel credentials are live
#
# ## C. Stripe webhook intake (assert travel_marketplace metadata)
# - [ ] Create a Stripe test-mode hotel checkout through in-app Elements
# - [ ] In Stripe Dashboard → PaymentIntent metadata, confirm:
#         checkout_type=travel_marketplace
#         attempt_id, transaction_id, user_id, email, kind, provider, amount_cents
# - [ ] Confirm webhook delivery of payment_intent.succeeded to /api/webhooks/stripe
#       succeeds (2xx) and the ledger row advances through SUPPLIER_SUBMITTED → CONFIRMED
#       with a real supplier_confirmation_number (minimum 3 characters)
# - [ ] Force a payment_intent.payment_failed (decline card) and confirm the matching
#       attempt + travel_booking_transactions rows become FAILED while still open
# - [ ] On intentional supplier book failure after charge, confirm automatic Stripe refund
#       metadata includes checkout_type=travel_marketplace and attempt_id, and ledger
#       lands FAILED/REFUNDED
#
# ## D. Amount-tampering + session-less resume
# - [ ] POST /api/travel/checkout/create-intent with injected amountCents / fareCents /
#       totalAmountCents / userId → HTTP 400 (authority gate)
# - [ ] Valid create-intent without money fields → live Expedia price-check wins;
#       charged total matches server itemization, not any client-offered price
# - [ ] Divergent hotel/car bookToken vs live Expedia token → rejection
#       ("bookToken divergence detected")
# - [ ] Clear browser sessionStorage entirely, then from My Trip open
#       /travel/checkout/continue?attemptId=<open attempt>
# - [ ] Resume hydrates fare / tax / service fee / total from the server resume payload
#       (no sessionStorage money path); hard refresh of the continue URL still works
# - [ ] Recreate path retires superseded opens via retireOpenDuplicateCheckoutAttempts
#       (stale DRAFT / PAYMENT_PENDING siblings for the same offer become FAILED)
#
# ## E. Official Lane A + retirement matrix
# - [ ] Official “Save housing interest” → DRAFT journey only (no PaymentIntent)
# - [ ] UI stays on the hotel page with Interest Saved / Contacting Housing
#       (no checkout redirect; redirectTo ignored if present)
# - [ ] POST /api/travel/reservations → 410
# - [ ] POST /api/travel/marketplace/booking/{confirm,recheck} → 410
# - [ ] booking/start and booking/return API directories are absent (deleted)
# - [ ] /travel/marketplace/return?attemptId=… → /travel/checkout/continue;
#       bare /travel/marketplace/return → /travel
# - [ ] Owner PATCH action=verify → 410; cancel + sync_supplier_status + refund_stripe work
#
# ## F. Definition of Done gate
# - [ ] npm run test:travel passes (includes runtime-integration.test.ts)
# - [ ] npm run build passes on the deployment target
# - [ ] GET /api/health ready
# - [ ] This checklist completed on the target project before declaring production PASS
#
