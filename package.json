{
  "name": "vital-organs-ent",
  "version": "0.1.1",
  "private": true,
  "packageManager": "npm@10.9.8",
  "scripts": {
    "dev": "node --max-http-header-size=32768 node_modules/next/dist/bin/next dev",
    "dev:https": "node --max-http-header-size=32768 node_modules/next/dist/bin/next dev --experimental-https",
    "build": "next build",
    "ionic:build": "next build",
    "build:mobile": "node scripts/build-mobile.mjs",
    "sync:profile-initials": "node scripts/sync-user-profile-initials.mjs",
    "start": "next start",
    "lint": "eslint .",
    "test:broadcast": "npx tsx --test services/broadcast/__tests__/**/*.test.ts",
    "test:streaming": "npx tsx --test lib/streaming/__tests__/**/*.test.ts",
    "test:honesty": "npx tsx --test lib/live/__tests__/attendee-live-honesty.test.ts",
    "test:events": "npx tsx --test lib/events/__tests__/**/*.test.ts",
    "test:registration": "npx tsx --test lib/registration/__tests__/**/*.test.ts",
    "test:credentials": "npx tsx --test lib/credentials/__tests__/**/*.test.ts",
    "test:phase5b": "npm run build && npx playwright test e2e/credential-public.spec.ts",
    "test:responsive": "node scripts/responsive-audit.mjs",
    "test": "npx tsx --test lib/live/__tests__/attendee-live-honesty.test.ts lib/events/__tests__/**/*.test.ts lib/registration/__tests__/**/*.test.ts lib/credentials/__tests__/**/*.test.ts lib/security/__tests__/**/*.test.ts lib/rate-limit/__tests__/**/*.test.ts lib/giving/__tests__/**/*.test.ts lib/dashboard/__tests__/**/*.test.ts",
    "verify:phase6b": "node scripts/verify-phase6b-live.mjs",
    "verify:phase7": "node scripts/verify-phase7-registration-live.mjs",
    "verify:phase8": "node scripts/verify-phase8-production.mjs",
    "perf:production": "node scripts/perf-production-check.mjs",
    "measure:todays-service": "node scripts/measure-todays-service-load.mjs",
    "db:migration:new": "node scripts/db-migration-new.mjs",
    "db:migrate": "node scripts/db-migrate.mjs",
    "db:schema:reload": "node scripts/db-schema-reload.mjs",
    "db:verify:mixers": "node scripts/db-verify-mixer-schema.mjs",
    "db:verify:streaming": "node scripts/db-verify-streaming-schema.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-ivs": "^3.1075.0",
    "@capacitor/android": "^8.4.1",
    "@capacitor/cli": "^8.4.1",
    "@capacitor/core": "^8.4.1",
    "@capacitor/ios": "^8.4.1",
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.107.0",
    "@tailwindcss/postcss": "^4.3.0",
    "amazon-ivs-web-broadcast": "^1.36.0",
    "expo": "^56.0.12",
    "framer-motion": "^12.40.0",
    "hls.js": "^1.6.16",
    "ioredis": "^5.11.1",
    "lucide-react": "^1.17.0",
    "next": "^16.2.7",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.85.3",
    "server-only": "^0.0.1",
    "stripe": "^22.2.0",
    "tailwindcss": "^4.3.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/react": "19.2.17",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.7",
    "playwright": "^1.62.1",
    "typescript": "6.0.3"
  },
  "optionalDependencies": {
    "@emnapi/core": "1.11.1",
    "@emnapi/runtime": "1.11.1"
  }
}
