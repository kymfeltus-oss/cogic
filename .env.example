# Supabase — vital-organs-entertainment project
# Dashboard: https://supabase.com/dashboard/project/tezzihhkqlovynybaypu

# IMPORTANT: Use your Supabase API URL, NOT https://supabase.co
# Correct format: https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://tezzihhkqlovynybaypu.supabase.co

# Supabase Dashboard → Authentication → URL Configuration → Redirect URLs must include:
# - http://localhost:3000/auth/callback
# - http://localhost:3000/auth/callback?next=/attendee-dashboard
# - http://localhost:3000/forgot-password
# - http://localhost:3000/reset-password
# - https://vitalorgansent.com/auth/callback
# - https://vitalorgansent.com/auth/callback?next=/attendee-dashboard
# - https://vitalorgansent.com/forgot-password
# - https://vitalorgansent.com/reset-password
#
# OAuth (Google, Facebook, Apple): enable each under Authentication → Providers.
# Each provider's redirect/callback URI must be:
#   https://YOUR-PROJECT-REF.supabase.co/auth/v1/callback
# Run `node scripts/verify-auth-config.mjs` for a full checklist.

# Use the anon (legacy) or publishable key from:
# Supabase Dashboard → Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key-here

# Server-only — Project Settings → API Keys → service_role (never expose to the browser)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Stripe — Dashboard → Developers → API keys
STRIPE_SECRET_KEY=sk_test_your-secret-key-here

# Public app URL used for Stripe success/cancel redirects
# Local dev: http://localhost:3000
# Vercel production: https://vitalorgansent.com
NEXT_PUBLIC_APP_URL=http://localhost:3000

# HLS live stream URL (.m3u8) for attendee /live player — must end in .m3u8 (not Restream RTMP or marketing URLs)
NEXT_PUBLIC_HLS_STREAM_URL=https://your-cdn.example.com/awakening-live.m3u8

# RTMP camera / OBS push ingest (ops-only — server env, never expose to attendees)
# Example Restream: rtmp://live.restream.io/live/your-stream-key
PRIMARY_RTMP_INGEST_URL=
BACKUP_RTMP_INGEST_URL=

# RTMP pull (Restream combined pull link) + in-app camera HLS preview — ops-only
# Example pull: rtmp://pull.restream.io/pull/your-pull-id
PRIMARY_RTMP_PULL_URL=
BACKUP_RTMP_PULL_URL=
CAMERA_PREVIEW_HLS_URL=

# Stripe webhook signing secret — from Dashboard or `stripe listen --forward-to localhost:3000/api/webhooks/stripe`
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-signing-secret-here

# Stripe Price IDs for Vital Seed bundles (Dashboard → Products → each tier → Price ID)
# Leave UNSET or blank to auto-build checkout from server prices ($1.99 / $4.99 / $8.99 / $15.99).
# Do NOT paste .env.example placeholders — invalid IDs break checkout.
# STRIPE_PRICE_SEEDS_100=price_...
# STRIPE_PRICE_SEEDS_300=price_...
# STRIPE_PRICE_SEEDS_600=price_...
# STRIPE_PRICE_SEEDS_1200=price_...

# Admin stream toggle — POST /api/stream/toggle (X-Admin-Secret-Key header)
ADMIN_SECRET_KEY=your-long-secure-admin-passphrase-here
# Optional separate password for the ops developer telemetry drawer (falls back to ADMIN_SECRET_KEY)
OPS_DEV_DRAWER_PASSWORD=

# Operations dashboard — comma-separated admin emails allowed at /ops and /ops/live-hub
# Without this (and without user_metadata.is_ops_admin), /ops returns application 404.
ADMIN_EMAILS=you@example.com,ops@example.com

# Crew roles — who may assume producer at /ops/live-hub (defaults to ADMIN_EMAILS when unset)
OPS_PRODUCER_EMAILS=producer@example.com,showcaller@example.com

# Local dev only — allow any signed-in user to access /ops when true (never enable in production)
OPS_ADMIN_DEV_BYPASS=false

# Ops auth diagnostics — logs safe gate decisions to server console when true
OPS_AUTH_DEBUG=false

# Optional attendee live render diagnostics — browser console.debug when true
NEXT_PUBLIC_LIVE_RENDER_DEBUG=false

# Build-phase only — skip paid ticket checks for authenticated users (server-only, never in production)
LIVE_ACCESS_DEV_BYPASS=false

# Live Hub vMix adapter — server-side fetch to local vMix HTTP API (optional; mock when unset)
# Browser never calls vMix directly — /api/owner/vmix/* proxies via VMIX_API_BASE_URL (owner auth required).
# Vercel-hosted routes cannot reach operator-local 127.0.0.1 — run Live Hub on the operator desktop.
VMIX_API_BASE_URL=http://127.0.0.1:8088/api
# Optional vMix input number for STINGER transition (PlayInput)
VMIX_STINGER_INPUT=

# Parable local agent (audio + network + streaming providers)
AUDIO_SERVICE_URL=http://127.0.0.1:8000
AUDIO_SERVICE_TOKEN=dev-audio-token
# Set to 1 to push video-only RTMP (FFmpeg -an; bypasses Windows DirectShow audio driver issues)
# Omit or set to 0 to include audio. Windows defaults to video-only when unset.
FFMPEG_DISABLE_AUDIO=1

# Production stream method defaults (Today's Service control room)
# Client-safe playback URL only — never put stream keys in NEXT_PUBLIC_*
NEXT_PUBLIC_DEFAULT_PLAYBACK_URL=https://www.vitalorgansent.com/live
# Server-only — attendee watch page (Church Website stream method)
CHURCH_PLAYBACK_URL=https://www.vitalorgansent.com/live
# Server-only — Custom RTMP stream method (Restream ingest); ops uses RTMP_INGEST_SERVER_BASE separately
CUSTOM_RTMP_URL=rtmp://live.restream.io/live
# Server-only fallback for Custom RTMP when no per-event key is saved in Supabase
CUSTOM_RTMP_STREAM_KEY=
# Server-only — attendee HLS .m3u8 for /live (Mux, Cloudflare Stream, CDN manifest — NOT rtmp:// or https://restream.io)
ATTENDEE_PLAYBACK_HLS_URL=
# Server-only — hot-standby backup HLS .m3u8 (Amazon IVS playback URL for owner failover lane)
ATTENDEE_BACKUP_HLS_URL=

# Streaming destination OAuth (server + local agent)
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=http://localhost:3000/api/v1/streaming/oauth/youtube/callback

FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_REDIRECT_URI=http://localhost:3000/api/v1/streaming/oauth/facebook/callback

VIMEO_CLIENT_ID=
VIMEO_CLIENT_SECRET=
VIMEO_REDIRECT_URI=http://localhost:3000/api/v1/streaming/oauth/vimeo/callback

TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_REDIRECT_URI=http://localhost:3000/api/v1/streaming/oauth/twitch/callback

# Encrypt OAuth tokens and per-event stream keys at rest (server-only, never NEXT_PUBLIC_*)
# Required on Vercel Production for Today's Service stream key generate/save.
# Use the SAME value in Vercel and local .env.local so keys encrypted locally decrypt in production.
# Generate a new value: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Vercel: Project → Settings → Environment Variables → Production (+ Preview if needed) → redeploy
TOKEN_ENCRYPTION_KEY=
# BROADCAST_DEV_MODE=true forces adapter mock snapshots when live APIs are unavailable.
# Defaults to dev-without-VMIX when unset.
BROADCAST_DEV_MODE=
OBS_WEBSOCKET_URL=
OBS_WEBSOCKET_PASSWORD=

# Live Hub Restream adapter — OAuth bearer token (optional; mock when unset)
# Polls https://api.restream.io channels + a short WebSocket snapshot for ingest bitrate.
# Optional comma-separated channel IDs to activate on Go Live (defaults to all channels).
# For past broadcast recording sync, token needs stream.read + storage.read scopes.
RESTREAM_API_TOKEN=
RESTREAM_PRIMARY_CHANNEL_IDS=
