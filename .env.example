# =============================================================================
# COGIC LIVE — environment template (NO real secrets)
# Authoritative Supabase project: wjlaaluonxiaxmytiqwi
# =============================================================================

# Supabase — COGIC LIVE
# Dashboard: https://supabase.com/dashboard/project/wjlaaluonxiaxmytiqwi
# IMPORTANT: Use your Supabase API URL, NOT https://supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://wjlaaluonxiaxmytiqwi.supabase.co

# Supabase Dashboard → Authentication → URL Configuration → Redirect URLs must include:
# - http://localhost:3000/auth/callback
# - http://localhost:3000/auth/callback?next=/attendee-dashboard
# - http://localhost:3000/forgot-password
# - http://localhost:3000/reset-password
# - https://YOUR-PRODUCTION-HOST/auth/callback
# - https://YOUR-PRODUCTION-HOST/auth/callback?next=/attendee-dashboard
# - https://YOUR-PRODUCTION-HOST/forgot-password
# - https://YOUR-PRODUCTION-HOST/reset-password
#
# OAuth provider callback URI:
#   https://wjlaaluonxiaxmytiqwi.supabase.co/auth/v1/callback

NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key-here

# Server-only — Project Settings → API Keys → service_role (never expose to the browser)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Stripe — Dashboard → Developers → API keys
# Production COGIC LIVE uses LIVE mode intentionally (sk_live_...).
# Local development may use sk_test_... when not exercising live charges.
STRIPE_SECRET_KEY=sk_live_your-secret-key-here

# Stripe webhook signing secret — Dashboard endpoint or `stripe listen --forward-to localhost:3000/api/webhooks/stripe`
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-signing-secret-here

# Convocation registration fee (integer cents). Required for checkout.
REGISTRATION_FEE_CENTS=25000
# Optional ISO currency (defaults to usd)
# REGISTRATION_CURRENCY=usd

# Public app URL used for Stripe success/cancel redirects and client origin.
# Local: http://localhost:3000
# Production: https://YOUR-PRODUCTION-HOST  (HTTPS required)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Canonical public HTTPS origin for QR credential deep links (preferred over NEXT_PUBLIC_APP_URL).
# Local: http://localhost:3000
# Production: https://YOUR-PRODUCTION-HOST  (HTTPS required; no legacy hosts)
COGIC_STREAM_PUBLIC_WEB_ORIGIN=http://localhost:3000

# Optional attendee-facing support mailbox (contact surfaces)
# NEXT_PUBLIC_SUPPORT_EMAIL=support@your-domain.example

# Public QR credential session — server-only, dedicated secret for /c HttpOnly cookie encryption.
# Do NOT reuse SUPABASE_SERVICE_ROLE_KEY, Supabase anon key, Stripe secret, or TOKEN_ENCRYPTION_KEY.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Verifier expects length >= 32.
COGIC_CREDENTIAL_SESSION_SECRET=

# Distributed rate limiting (required for multi-instance Vercel enforcement)
# Uses ioredis. When unset, limiters fail open (traffic allowed) and health reports rateLimitConfigured=false.
# REDIS_URL=redis://:password@host:6379
# UPSTASH_REDIS_URL=rediss://:password@host:6379
# RATE_LIMIT_REDIS_URL=redis://:password@host:6379

# Operations — comma-separated owner/admin emails
ADMIN_EMAILS=you@example.com,ops@example.com

# Crew roles — who may assume producer at /ops/live-hub (defaults to ADMIN_EMAILS when unset)
OPS_PRODUCER_EMAILS=producer@example.com,showcaller@example.com

# ---------------------------------------------------------------------------
# DEV BYPASSES — must remain false or UNSET in Production
# ---------------------------------------------------------------------------
OPS_ADMIN_DEV_BYPASS=false
LIVE_ACCESS_DEV_BYPASS=false

# Ops auth diagnostics — logs safe gate decisions to server console when true
OPS_AUTH_DEBUG=false

# Optional attendee live render diagnostics — browser console.debug when true
NEXT_PUBLIC_LIVE_RENDER_DEBUG=false

# Admin stream toggle — POST /api/stream/toggle (X-Admin-Secret-Key header)
ADMIN_SECRET_KEY=your-long-secure-admin-passphrase-here
OPS_DEV_DRAWER_PASSWORD=

# HLS live stream URL (.m3u8) for attendee /live player
NEXT_PUBLIC_HLS_STREAM_URL=https://your-cdn.example.com/cogic-live.m3u8

# RTMP camera / OBS push ingest (ops-only — server env, never expose to attendees)
PRIMARY_RTMP_INGEST_URL=
BACKUP_RTMP_INGEST_URL=
PRIMARY_RTMP_PULL_URL=
BACKUP_RTMP_PULL_URL=
CAMERA_PREVIEW_HLS_URL=

# Live Hub vMix adapter (optional; mock when unset)
VMIX_API_BASE_URL=http://127.0.0.1:8088/api
VMIX_STINGER_INPUT=

# Local agent helpers
AUDIO_SERVICE_URL=http://127.0.0.1:8000
AUDIO_SERVICE_TOKEN=dev-audio-token
FFMPEG_DISABLE_AUDIO=1

# Production stream method defaults
NEXT_PUBLIC_DEFAULT_PLAYBACK_URL=https://YOUR-PRODUCTION-HOST/live
CHURCH_PLAYBACK_URL=https://YOUR-PRODUCTION-HOST/live
CUSTOM_RTMP_URL=rtmp://live.restream.io/live
CUSTOM_RTMP_STREAM_KEY=
ATTENDEE_PLAYBACK_HLS_URL=
ATTENDEE_BACKUP_HLS_URL=

# Streaming destination OAuth (server + local agent)
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=http://localhost:3000/api/v1/streaming/oauth/youtube/callback
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_REDIRECT_URI=http://localhost:3000/api/v1/streaming/oauth/facebook/callback
VIMEO_CLIENT_ID=
VIMEO_CLIENT_SECRET=
VIMEO_REDIRECT_URI=http://localhost:3000/api/v1/streaming/oauth/vimeo/callback
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_REDIRECT_URI=http://localhost:3000/api/v1/streaming/oauth/twitch/callback

# Encrypt OAuth tokens and per-event stream keys at rest (server-only)
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=

BROADCAST_DEV_MODE=
OBS_WEBSOCKET_URL=
OBS_WEBSOCKET_PASSWORD=
RESTREAM_API_TOKEN=
RESTREAM_PRIMARY_CHANNEL_IDS=
